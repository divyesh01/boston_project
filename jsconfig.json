{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/components/**/*.js",
    "src/components/**/*.jsx",
    "src/pages/**/*.jsx",
    "src/pages/**/*.js",
    "src/Layout.jsx",
    "src/types/**/*.js",
    "src/lib/**/*.js",
    "src/lib/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/vite-plugins",
    "src/api",
    "src/components/ui"
  ]
}
