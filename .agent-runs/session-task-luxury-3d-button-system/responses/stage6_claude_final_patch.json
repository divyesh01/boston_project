### FILE: src/index.css
```css
/* ============================================================
   Luxury 3D Button System — minimal global support layer.
   Component styling and ALL motion live in components/ui/button.jsx
   (CVA). This block is additive only: it sets NO global
   `button { transition/transform }` rule and uses NO !important,
   so it cannot fight framer-motion or override the CVA utilities.
   Reduced-motion is handled authoritatively by the component-level
   motion-reduce:* utilities; nothing global is needed here.
   ============================================================ */
@layer base {
  button,
  [role="button"] {
    -webkit-tap-highlight-color: transparent;
  }
}

@layer components {
  :root {
    /* Reusable luxury depth tokens for any bespoke (non-CVA) button. */
    --btn-bevel-strong: inset 0 1px 0 rgba(255, 255, 255, 0.16);
    --btn-bevel-soft: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    --btn-contact-shadow: 0 2px 4px -1px rgba(0, 0, 0, 0.5),
      0 1px 2px rgba(0, 0, 0, 0.4);
    --btn-contact-shadow-hover: 0 6px 12px -2px rgba(0, 0, 0, 0.55),
      0 3px 6px rgba(0, 0, 0, 0.4);
    --btn-pressed-shadow: 0 1px 2px rgba(0, 0, 0, 0.45),
      inset 0 1px 2px rgba(0, 0, 0, 0.3);
    --btn-focus-ring: #00e096;
  }
}
```

