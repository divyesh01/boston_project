# ==============================================================================
# RRI BULK IMPORT CANARY ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `canary.env` or export these variables in your shell.
# DO NOT commit populated secrets or real credentials to source control.
#
# 🔒 SAFETY DIRECTIVE:
# This automation harness includes strict production guards that will HARD-ABORT
# if directed toward production hosts, workers, or D1 databases:
#   - FORBIDDEN HOST:    boston-project.divyesh-boston.workers.dev
#   - FORBIDDEN SERVICE: boston-project
#   - FORBIDDEN D1 NAME: boston-project-production-auth
#   - FORBIDDEN D1 ID:   e9008126-d4b4-4588-841c-128eadd94c8d
# ==============================================================================

# MANDATORY: Explicit confirmation of isolated non-production target environment.
# The harness will refuse to run if this is not exactly "YES".
CANARY_CONFIRM_ISOLATED=YES

# Target Canary Worker URL (must NOT be the production worker)
# Example: https://rri-bulk-canary-a61a110.divyesh-boston.workers.dev
CANARY_WORKER_URL=https://rri-bulk-canary-a61a110.divyesh-boston.workers.dev

# Scoped Account ID and Property ID in Canary D1
CANARY_ACCOUNT_ID=canary-account-1
CANARY_PROPERTY_ID=canary-prop-1

# Authenticated session credentials for the canary test identity.
# Must possess Owner or Admin role on the target canary account/property.
# Provide either CANARY_AUTH_COOKIE or CANARY_AUTH_TOKEN:
CANARY_AUTH_COOKIE="__Host-session=example_canary_session_token_here"
# CANARY_AUTH_TOKEN="example_bearer_token_here"

# Safety opt-in for testing Cloudflare R2 Bucket Retention Lock error mapping (HTTP 423).
# Leave false unless you have applied a temporary bucket retention rule to the canary bucket.
CANARY_ALLOW_BUCKET_LOCK=false

# Optional request timeout in milliseconds (default: 30000)
CANARY_TIMEOUT_MS=30000
