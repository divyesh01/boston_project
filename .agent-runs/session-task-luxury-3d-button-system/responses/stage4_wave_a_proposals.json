        // Ghost — flat until hover, no elevation.
        ghost:
          "text-slate-200 hover:bg-white/[0.06] hover:text-white active:bg-white/[0.03]",
        // Link — emerald brand accent, no depth.
        link: "text-[color:var(--brand)] underline-offset-4 hover:underline",
