# ─────────────────────────────────────────────────────────────────────────────
# Red Roof Intelligence — environment template
#
# Copy to .env.local and fill in. Never commit a filled-in copy: .gitignore
# swallows every .env.* EXCEPT this template (there is an explicit `!.env.example`
# negation, because without it this file would be invisible to git and a new
# deploy would have nothing to copy).
#
# Every name below was taken from an actual call site in the code, listed next to
# it. Vite only exposes variables prefixed VITE_ to the browser — so treat every
# value in this file as PUBLIC. Real secrets are listed at the bottom and do NOT
# belong here.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base44 backend wiring ───────────────────────────────────────────────────

# Cloud app id. Read at src/api/base44Client.js:110.
#
# CAUTION: that line is `import.meta.env?.VITE_BASE44_APP_ID || PRODUCTION_APP_ID`,
# and no .env file in this repo sets the variable today — so the constant declared
# at base44Client.js:49 is the configuration of every build produced here. An
# unconfigured build does NOT fail; it silently talks to the production tenant.
# Set it explicitly in every environment so a misconfigured deploy is obvious
# instead of silent. (The id is not a secret — it ships in the JS bundle, travels
# as the X-App-Id header, and is duplicated in base44/.app.jsonc — the hazard is
# defaulting to the wrong tenant, not exposure. Do not "fix" it by making the
# fallback throw: that would brick every current deployment.)
VITE_BASE44_APP_ID=

# Backend origin for the Base44 SDK. Read at src/api/base44Client.js:111,
# defaults to "" (the SDK's own default host).
VITE_BASE44_BACKEND_URL=

# ─── Declared but currently inert — setting these changes nothing ────────────
#
# Both are consumed only by src/lib/app-params.js, and NOTHING in src/ imports
# that module, so Vite drops it: the built bundle contains zero occurrences of the
# localStorage keys it writes (base44_app_id, base44_app_base_url,
# base44_functions_version, base44_from_url), against live controls that do
# appear. They are listed here so nobody assumes they work — pinning a deployed
# functions version with VITE_BASE44_FUNCTIONS_VERSION today has NO EFFECT.
#
# Do not make them live by adding an import. getAppParamValue() prefers a URL
# query parameter over the configured value and persists it to localStorage, and
# only app_base_url is validated against a hostname allowlist — app_id and
# functions_version would become attacker-settable via a crafted link.
# scripts/probe-app-config.mjs fails if an importer appears.
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=

# ─── Auth mode — the one setting that can break the security model ───────────

# Enables the in-browser offline auth shim. Read at src/api/base44Client.js:1970
# as a STRING compare against 'true', so only the exact text `true` turns it on.
#
# DANGER: `true` in a deployed build means the browser performs its own auth and
# MFA verification — trivially bypassable. It must be `true` ONLY in
# .env.development (vite dev). Keep it false here and in .env.production.
# .env.local is loaded by Vite in EVERY mode including `vite build`, so never
# put `true` in .env.local either.
VITE_USE_LOCAL_AUTH=false

# ─── Optional: realtime ──────────────────────────────────────────────────────

# WebSocket endpoint for CRDT sync. Read at src/crdt.jsx:18, defaults to ''.
# Blank disables realtime sync (the app works offline-first without it).
VITE_WEBSOCKET_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE SECRETS — NOT env vars, do not add them here
#
# The serverless functions read these from the Base44 secret store via
# `secrets.get('NAME')`, not from process.env. Putting them in a .env file does
# nothing except risk committing them:
#
#   AUDIT_CHAIN_SECRET   HMAC key for the audit hash chain. Read by audit_log,
#                        audit_verify, custom_auth_login, custom_auth_reset_password,
#                        custom_user_admin, autoPayroll, deleteAccount.
#                        custom_user_admin/entry.js:513 REFUSES every write action
#                        when it is unset — an unset secret fails closed.
#   OPENWEATHER_API_KEY  getWeather/entry.ts:13. The proxy exists so this key
#                        never reaches the browser.
#   CRON_SECRET          autoPayroll/entry.ts:147. Authenticates the scheduled run.
#
# Set them with the Base44 CLI / dashboard secret store.
#
# Server-side plain env vars (set by the host, not by this file): NODE_ENV,
# ALLOWED_ORIGINS, BASE44_LEGACY_SDK_IMPORTS.
# ─────────────────────────────────────────────────────────────────────────────
