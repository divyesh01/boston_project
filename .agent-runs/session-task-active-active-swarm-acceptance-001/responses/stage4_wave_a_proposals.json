/**
 * Swarm Orchestrator Contract & Invariant Diagnostics
 * ---------------------------------------------------
 * Single source of truth for the swarm's version identity, active-active
 * provider topology, safety invariants, and live worker capabilities.
 *
 * ARCHITECTURAL CONSTRAINTS (do not relax):
 *   - Leaf module: zero imports, zero I/O, zero side effects at import time.
 *   - No environment reads. An invariant that varies by environment is not an
 *     invariant; enforcement/measurement belongs in the router and evidence layer.
 *   - Declarative only. This module states policy; it does not observe runtime.
 *   - Public surface is exactly the four named exports below. No default export.
 *
 * Consumers: autonomousOrchestrator, universalModelRouter, naraHelperPool,
 * scripts/orchestrator/*, tests/orchestrator/*, evidence integrity tests.
 *
 * @module lib/swarmOrchestratorContract
 */

/* -------------------------------------------------------------------------- */
/* Module-private canonical values (frozen source of truth)                   */
/* -------------------------------------------------------------------------- */

/** Semantic version of the swarm orchestration contract itself. */
const SWARM_VERSION = '2.0.0';

/** Architecture identifier reported alongside the version. */
const SWARM_ARCHITECTURE = 'ACTIVE_ACTIVE_HIGH_PARALLELISM_SWARM';

/** Release status of the contract. */
const SWARM_STATUS = 'PRODUCTION_READY';

/** Authoritative synthesis brain. Never load-balanced away. */
const PRIMARY_BRAIN = 'CLAUDE_OPUS';

/**
 * Providers driven concurrently (not failover). Frozen so no consumer can
 * mutate the canonical topology; callers receive fresh clones.
 */
const ACTIVE_ACTIVE_PROVIDERS = Object.freeze(['TABITOKEN', 'GOROUTER']);

/** Concurrency mode for the active-active pair. */
const TOPOLOGY_MODE = 'ACTIVE_ACTIVE_CONCURRENT';

/** Policy governing distribution across the active-active pair. */
const BALANCING_POLICY = 'DYNAMIC_HEALTH_AND_WORKLOAD_BALANCED';

/** Ordered execution waves. Order is significant: A -> B -> C. */
const EXECUTION_WAVES = Object.freeze([
  'WAVE_A_PARALLEL_CLAUDE_OPUS',
  'WAVE_B_SPECIALIST_REVIEWER_SWARM',
  'WAVE_C_AUTHORITATIVE_SYNTHESIS',
]);

/**
 * Full set of providers reachable by live workers, including the terminal
 * deterministic fallback that guarantees the swarm always yields a result.
 */
const WORKER_ACTIVE_PROVIDERS = Object.freeze([
  'TABITOKEN',
  'GOROUTER',
  'NARA',
  'LOCAL_DETERMINISTIC',
]);

/** Concurrency primitive used by the worker pool. */
const CONCURRENCY_MODEL = 'ASYNC_PROMISE_ALL_BOUNDED';

/* --- Invariant declarations ------------------------------------------------ */

/** Codex quota must remain untouched by swarm execution. */
const CODEX_QUOTA_USAGE = '0% (CONSERVED)';

/** Antigravity may be consulted as an external API but must never author code. */
const ANTIGRAVITY_AUTHORING = 'BLOCKED (EXTERNAL API ONLY)';

/** Every produced artifact requires SHA-256 verification before acceptance. */
const SHA256_VERIFICATION_REQUIRED = true;

/** Protected files are locked against autonomous modification. */
const PROTECTED_FILES_LOCKED = true;

/** Routing optimizes for output quality, never for lowest token cost. */
const QUALITY_OVER_COST = true;

/**
 * Deterministic fallback timestamp used only when the host clock is unusable
 * (e.g. aggressive fake timers in a test harness). Valid ISO-8601 by design.
 */
const FALLBACK_ISO_TIMESTAMP = '1970-01-01T00:00:00.000Z';

/* -------------------------------------------------------------------------- */
/* Module-private helpers                                                     */
/* -------------------------------------------------------------------------- */

/**
 * Clone a frozen canonical list so callers may freely sort, filter, or mutate
 * the value they receive without corrupting the module's source of truth.
 *
 * @param {ReadonlyArray<string>} source Frozen canonical list.
 * @returns {string[]} Fresh, mutable copy.
 */
function cloneList(source) {
  return Array.isArray(source) ? source.slice() : [];
}

/**
 * Produce an ISO-8601 timestamp without ever throwing.
 *
 * `new Date().toISOString()` raises RangeError when the underlying date is
 * invalid, which occurs under some fake-timer/mocked-clock configurations.
 * The version probe is called from evidence-integrity paths, so a clock fault
 * must not be able to fail an unrelated audit. Degrade to a valid constant.
 *
 * @returns {string} A syntactically valid ISO-8601 timestamp.
 */
function safeIsoTimestamp() {
  try {
    const now = new Date();
    const millis = now.getTime();
    if (typeof millis !== 'number' || !Number.isFinite(millis)) {
      return FALLBACK_ISO_TIMESTAMP;
    }
    const iso = now.toISOString();
    return typeof iso === 'string' && iso.length > 0 ? iso : FALLBACK_ISO_TIMESTAMP;
  } catch {
    return FALLBACK_ISO_TIMESTAMP;
  }
}

/* -------------------------------------------------------------------------- */
/* Public contract surface                                                    */
/* -------------------------------------------------------------------------- */

/**
 * Report the swarm orchestrator's version identity.
 *
 * The only non-deterministic field is `timestamp`; all other fields are stable
 * across calls, and key order is fixed so serialized output is snapshot- and
 * hash-stable apart from that field.
 *
 * @returns {{version: string, architecture: string, status: string, timestamp: string}}
 */
export function getSwarmOrchestratorVersion() {
  return {
    version: SWARM_VERSION,
    architecture: SWARM_ARCHITECTURE,
    status: SWARM_STATUS,
    timestamp: safeIsoTimestamp(),
  };
}

/**
 * Report the active-active provider topology.
 *
 * `activeActiveProviders` are driven concurrently rather than as a failover
 * chain; `primaryBrain` is the authoritative synthesizer and is never balanced
 * away. The returned array is a fresh copy and is safe to mutate.
 *
 * @returns {{primaryBrain: string, activeActiveProviders: string[], mode: string, balancingPolicy: string}}
 */
export function getActiveActiveProviderTopology() {
  return {
    primaryBrain: PRIMARY_BRAIN,
    activeActiveProviders: cloneList(ACTIVE_ACTIVE_PROVIDERS),
    mode: TOPOLOGY_MODE,
    balancingPolicy: BALANCING_POLICY,
  };
}

/**
 * Report the swarm's declared safety invariants.
 *
 * These are declarative policy assertions, not runtime measurements. Actual
 * enforcement lives in the router (quota/provider gating) and the evidence
 * layer (SHA-256 verification, protected-file locks). Consumers that need to
 * *prove* conformance should compare observed state against these values.
 *
 * @returns {{codexQuotaUsage: string, antigravityAuthoring: string, sha256VerificationRequired: boolean, protectedFilesLocked: boolean, qualityOverCost: boolean}}
 */
export function verifySwarmInvariants() {
  return {
    codexQuotaUsage: CODEX_QUOTA_USAGE,
    antigravityAuthoring: ANTIGRAVITY_AUTHORING,
    sha256VerificationRequired: SHA256_VERIFICATION_REQUIRED,
    protectedFilesLocked: PROTECTED_FILES_LOCKED,
    qualityOverCost: QUALITY_OVER_COST,
  };
}

/**
 * Report live worker capabilities: ordered execution waves, the full reachable
 * provider set, and the concurrency primitive in use.
 *
 * `waves` order is significant (A -> B -> C). `activeProviders` includes the
 * terminal `LOCAL_DETERMINISTIC` fallback that guarantees the swarm always
 * produces a result even when every external provider is unavailable. Both
 * arrays are fresh copies and safe to mutate.
 *
 * @returns {{waves: string[], activeProviders: string[], concurrencyModel: string}}
 */
export function getLiveWorkerCapabilities() {
  return {
    waves: cloneList(EXECUTION_WAVES),
    activeProviders: cloneList(WORKER_ACTIVE_PROVIDERS),
    concurrencyModel: CONCURRENCY_MODEL,
  };
}
