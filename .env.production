# Production build (vite build).
#
# THIS FILE IS COMMITTED, on purpose (see the negation in .gitignore). Both values
# below are public: Vite folds every VITE_-prefixed variable into the shipped
# JavaScript, so anyone who loads the site can already read them. Keeping the file
# untracked bought no secrecy and cost two dead deploys — Cloudflare's Git build
# and GitHub Actions both clone the repo and saw neither flag, so they produced a
# bundle that loads and can never log anybody in.
#
# NEVER add a secret, token, key or password to this file. scripts/probe-standalone-deploy.mjs
# section 7 fails the gate if any key other than the public mode switches below
# appears here.
# Secrets belong in the hosting dashboard, which is not in version control.
#
# STANDALONE deployment. The base44 backend this app was generated against is no
# longer in use, so the serverless custom_auth_* / audit_log functions do not
# exist any more. VITE_USE_LOCAL_AUTH routes every auth call through the
# in-browser shims instead. Without it a deployed build reaches for a backend that
# is gone and nobody can log in at all.
#
# That path is only acceptable because the deployment sits behind an upstream
# identity proxy (Cloudflare Access) which authenticates the request before this
# bundle is served. src/main.jsx therefore demands VITE_STANDALONE_LOCAL as a
# deliberate second declaration; one flag on its own still refuses to boot.
#
# Consequences, stated plainly so nobody is surprised later:
#   - auth and MFA are verified in the browser and are bypassable by whoever
#     controls the browser. The real boundary is the identity proxy, not this app.
#   - there is no server-side audit hash chain; audit_log ran on the removed
#     backend, so AUDIT_CHAIN_SECRET is moot for this deployment.
#   - data lives in this browser's IndexedDB and does NOT travel between devices.
#
# NEVER set VITE_STANDALONE_LOCAL on a build that can be reached anonymously.
VITE_USE_LOCAL_AUTH=false
VITE_STANDALONE_LOCAL=false

# Authentication is authoritative in the same-origin Worker. This is separate
# from business storage: hotel data remains in this browser's IndexedDB.
VITE_USE_SERVER_AUTH=true
VITE_USE_D1_API=false
