{
  "name": "SourceDay",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "report_type": {
      "type": "string"
    },
    "import_id": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "day_of_week": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "net_revenue": {
      "type": "number"
    },
    "stays": {
      "type": "number"
    },
    "adr": {
      "type": "number"
    },
    "occupancy_contribution": {
      "type": "number"
    },
    "revpar_contribution": {
      "type": "number"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "user_condition": {
            "is_active": true
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "data.property_id": {
                "$in": "{{user.property_access}}"
              }
            }
          ]
        }
      ]
    },
    "write": {
      "$and": [
        {
          "user_condition": {
            "is_active": true
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "data.property_id": {
                "$in": "{{user.property_access}}"
              }
            }
          ]
        }
      ]
    }
  }
}
