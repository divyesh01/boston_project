{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boston-project-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Preview URLs are unnecessary for this protected staging environment and
  // would create extra hostnames outside the explicit Access application.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boston-project-staging-data",
      "database_id": "5d5ff049-c273-4557-9938-e89c5d32112c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "ACCESS_TEAM_DOMAIN": "https://tight-feather-dba0.cloudflareaccess.com",
    "ACCESS_AUD": "67befe0c14f5acc168e10af9e93ad7a58880875d5251f3d87497a86c2f019128",
    "BOOTSTRAP_OWNER_EMAIL": "divyesh.boston@gmail.com",
    "MAX_SNAPSHOT_BYTES": "20000000",
    "SNAPSHOT_CHUNK_BYTES": "750000"
  },
  "observability": {
    "enabled": true,
    // Keep full invocation/error logs for diagnosis. At the Free Worker ceiling
    // of 100k requests/day this remains within the 200k log-event allowance as
    // long as application code logs errors only (worker/index.ts does).
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    // Traces begin sharing the metered observability-event pool in Oct 2026.
    // Logs give this small staging service the useful evidence without spans.
    "traces": { "enabled": false, "head_sampling_rate": 0 }
  }
}
